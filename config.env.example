# =============================================================================
# painelAIO — copie para config.env (nunca vai para o Git) e preencha
# =============================================================================

# --- Banco MCID (só na VPN) — os mesmos valores do painelcargaaio/config.env ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=se_cgpac

# --- Supabase (Project Settings › API) ---
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Secret key (sb_secret_...) ou a antiga service_role. Dá acesso total: só aqui.
SUPABASE_SERVICE_KEY=

# Conexão direta (Connect › Session pooler) — só para python/aplicar_sql.py. Contém a senha do banco.
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# --- Domínio dos e-mails de login da equipe ---
EMAIL_DOMINIO=cidades.gov.br
